<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Статистика — Дашборд</title>
    <link rel="stylesheet" href="/styles.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .dashboard { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; margin-bottom: 15px; }
        .metric-card {
            background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
            padding: 20px; text-align: left;
        }
        .metric-title { color: var(--muted); font-size: 13px; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 1px; }
        .metric-value { font-size: 32px; font-weight: bold; color: var(--text); }
        
        .charts-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 15px; margin-bottom: 15px; }
        .chart-box {
            background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
            padding: 20px; height: 350px;
            display: flex; flex-direction: column; overflow: hidden;
        }
        .chart-container {
            position: relative; flex-grow: 1; width: 100%; height: 100%;
        }

        .table-box {
            background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
            padding: 20px; max-height: 400px; overflow-y: auto;
        }
        
        .data-table { width: 100%; border-collapse: collapse; text-align: left; }
        .data-table th { color: var(--muted); font-size: 12px; padding: 10px 5px; border-bottom: 1px solid var(--border); }
        .data-table td { padding: 12px 5px; border-bottom: 1px solid rgba(255,255,255,0.05); font-size: 14px; }
        
        @media (max-width: 900px) {
            .dashboard { grid-template-columns: repeat(2, 1fr); }
            .charts-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

<header class="site-header">
    <div class="container header-inner">
        <a class="logo" href="/"><img class="logo__image" src="/images/logo.svg"><span class="logo__text">GameCard</span></a>
        <a class="profile-link" href="/admin">Назад в админку</a>
    </div>
</header>

<main class="container section" style="max-width: 1400px;">
    
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h1 class="page-title__title" style="margin: 0;">Панель аналитики</h1>
        <button class="button" onclick="loadStats()">🔄 Обновить</button>
    </div>

    <div class="dashboard">
        <div class="metric-card">
            <div class="metric-title">Общая выручка</div>
            <div class="metric-value" style="color: var(--green);" id="totalRevenue">0 ₽</div>
        </div>
        <div class="metric-card">
            <div class="metric-title">Заказов оформлено</div>
            <div class="metric-value" id="totalOrders">0</div>
        </div>
        <div class="metric-card">
            <div class="metric-title">Пользователей</div>
            <div class="metric-value" style="color: var(--yellow);" id="totalUsers">0</div>
        </div>
        <div class="metric-card">
            <div class="metric-title">Действий сегодня</div>
            <div class="metric-value" style="color: var(--pink);" id="totalToday">0</div>
        </div>
    </div>

    <div class="charts-grid">
        <!-- ГРАФИК АКТИВНОСТИ -->
        <div class="chart-box">
            <h3 style="font-size: 16px; margin-bottom: 15px; color: var(--muted);">Активность по дням</h3>
            <div class="chart-container">
                <canvas id="lineChart"></canvas>
            </div>
        </div>
        
        <!-- ПОНЧИК -->
        <div class="chart-box">
            <h3 style="font-size: 16px; margin-bottom: 15px; color: var(--muted);">Типы действий</h3>
            <div class="chart-container">
                <canvas id="donutChart"></canvas>
            </div>
        </div>
    </div>

    <div class="table-box">
        <h3 style="font-size: 16px; margin-bottom: 15px; color: var(--muted);">Последние события</h3>
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width: 100px;">Время</th>
                    <th>Действие</th>
                    <th>Страница</th>
                </tr>
            </thead>
            <tbody id="logsTable">
                <tr><td colspan="3" style="text-align: center;">Загрузка...</td></tr>
            </tbody>
        </table>
    </div>
</main>

<nav class="tabbar">
    <ul class="tabbar__list">
        <li><a class="tab" href="/"><span class="tab__icon">🏠</span>Главная</a></li>
        <li><a class="tab" href="/catalog"><span class="tab__icon">🛍️</span>Каталог</a></li>
        <li><a class="tab" href="/cart"><span class="tab__icon">🛒</span>Корзина</a></li>
        <li><a class="tab" href="/profile"><span class="tab__icon">👤</span>Профиль</a></li>
        <li><a class="tab tab_active" href="/admin"><span class="tab__icon">⚙️</span>Админ панель</a></li>
    </ul>
</nav>

<script>
    let lineChartInstance = null;
    let donutChartInstance = null;

    // Цвета по умолчанию для осей (серые)
    Chart.defaults.color = '#a3a5c9';
    Chart.defaults.borderColor = 'rgba(255,255,255,0.05)';

    function loadStats() {
        fetch('/admin/stats/data')
            .then(res => res.json())
            .then(data => {
                document.getElementById('totalRevenue').innerText = data.totalRevenue.toLocaleString() + ' ₽';
                document.getElementById('totalOrders').innerText = data.totalOrders;
                document.getElementById('totalUsers').innerText = data.totalUsers;
                document.getElementById('totalToday').innerText = data.totalToday;

                let html = "";
                data.lastLogs.forEach(log => {
                    html += `<tr>
                        <td style="color: var(--muted);">${log.time}</td>
                        <td><span style="color: var(--primary-light);">${log.action}</span></td>
                        <td style="color: var(--muted);">${log.page}</td>
                    </tr>`;
                });
                document.getElementById('logsTable').innerHTML = html;

                // --- ГРАФИК 1: СТОЛБЧАТЫЙ (Прижат влево) ---
                if (lineChartInstance) lineChartInstance.destroy();
                lineChartInstance = new Chart(document.getElementById('lineChart'), {
                    type: 'bar',
                    data: {
                        labels: data.chartLabels,
                        datasets: [{
                            data: data.chartData,
                            backgroundColor: '#7b6cf6',
                            borderRadius: 6,
                            maxBarThickness: 50 // Нормальная ширина столбика
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: {
                                offset: false, // Прижимает к оси Y
                                grid: { display: false }
                            },
                            y: {
                                beginAtZero: true,
                                ticks: { precision: 0 },
                                grid: { color: 'rgba(255,255,255,0.05)' }
                            }
                        }
                    }
                });

                // --- ГРАФИК 2: ПОНЧИК (Нормальной толщины и с белым текстом) ---
                if (donutChartInstance) donutChartInstance.destroy();
                donutChartInstance = new Chart(document.getElementById('donutChart'), {
                    type: 'doughnut',
                    data: {
                        labels: data.donutLabels,
                        datasets: [{
                            data: data.donutData,
                            backgroundColor: ['#7b6cf6', '#e879c8', '#4ade80', '#fbbf24'],
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '65%', // Нормальная толщина (не слишком тонкая)
                        layout: {
                            padding: { bottom: 10 }
                        },
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    color: '#ffffff', // БЕЛЫЙ ТЕКСТ
                                    boxWidth: 12,
                                    padding: 15,
                                    font: {
                                        size: 12,
                                        weight: 'bold' // Чуть жирнее для читаемости
                                    }
                                }
                            }
                        }
                    }
                });
            })
            .catch(err => console.error(err));
    }

    document.addEventListener("DOMContentLoaded", loadStats);
</script>

</body>
</html>
