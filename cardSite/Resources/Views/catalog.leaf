<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Каталог — GameCard</title>
    <link rel="icon" href="/images/logo.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="/print.css" media="print">
</head>
<body>

<header class="site-header">
    <div class="container header-inner">
        <a class="logo" href="/">
            <img class="logo__image" src="/images/logo.svg" alt="GameCard">
            <span class="logo__text">GameCard</span>
        </a>

        #if(userLogin != ""):
            <a class="profile-link" href="/profile">
                <span class="avatar">#(avatarLetter)</span>
                <span>#(userLogin)</span>
            </a>
        #else:
            <a class="profile-link" href="#" onclick="showAuthModal('', 'login'); return false;">
                <span class="avatar">Г</span>
                <span>Войти</span>
            </a>
        #endif
    </div>
</header>

<main>
    <div class="container page-title">
        <h1 class="page-title__title">Каталог товаров</h1>
        <p class="page-title__note">Доступно #count(products) товаров. Недоступные сочетания фильтров подсвечены серым.</p>
    </div>

    <div class="container catalog-layout">
        <aside class="catalog-sidebar">
            <form action="/catalog" method="get" class="filters">

                <div class="filter-group">
                    <h3 class="filter-group__title">Платформа</h3>
                    #for(opt in platformOptions):
                        <label class="checkbox #if(opt.isDisabled):checkbox_disabled#endif">
                            <input type="checkbox" name="platform" value="#(opt.value)"
                                   #if(opt.isSelected):checked#endif
                                   #if(opt.isDisabled):disabled#endif>
                            <span>#(opt.title)</span>
                        </label>
                    #endfor
                </div>

                <div class="filter-group">
                    <h3 class="filter-group__title">Страна</h3>
                    #for(opt in countryOptions):
                        <label class="checkbox #if(opt.isDisabled):checkbox_disabled#endif">
                            <input type="checkbox" name="country" value="#(opt.value)"
                                   #if(opt.isSelected):checked#endif
                                   #if(opt.isDisabled):disabled#endif>
                            <span>#(opt.title)</span>
                        </label>
                    #endfor
                </div>

                <div class="filter-group">
                    <h3 class="filter-group__title">Цена, до #(maxPrice) ₽</h3>
                    <input class="range" type="range" name="maxPrice"
                           min="500" max="#(maxPriceLimit)" step="100" value="#(maxPrice)">
                </div>

                <div class="filter-group">
                    <h3 class="filter-group__title">Сортировка</h3>
                    <select class="select" name="sort">
                        <option value="popular"    #if(sort == "popular"):selected#endif>Сначала популярные</option>
                        <option value="price-asc"  #if(sort == "price-asc"):selected#endif>Цена: по возрастанию</option>
                        <option value="price-desc" #if(sort == "price-desc"):selected#endif>Цена: по убыванию</option>
                        <option value="rating"     #if(sort == "rating"):selected#endif>По рейтингу</option>
                    </select>
                </div>

                <button class="button" type="submit">Применить</button>
                <a class="button button_ghost" href="/catalog">Сбросить</a>
            </form>
        </aside>

        <section>
            #if(isEmpty):
                <p class="catalog-empty">Ничего не найдено.</p>
            #else:
                <div class="products">
                    #for(product in products):
                        <article class="product-card">
                            <div class="product-card__media">
                                <img src="#(product.image)" alt="#(product.name)" loading="lazy" decoding="async">
                            </div>
                            <div class="product-card__body">
                                <h3 class="product-card__name">#(product.name)</h3>
                                <p class="product-card__description">#(product.description)</p>
                                <ul class="product-card__meta">
                                    <li>#(product.platformTitle)</li>
                                    <li>#(product.countryTitle)</li>
                                    <li>#(product.nominal)</li>
                                </ul>
                                <p class="product-card__rating">★ #(product.rating)</p>
                                <div class="product-card__bottom">
                                    <p class="price">#(product.price) ₽</p>
                                    <form action="/cart/add" method="post" style="display:inline">
                                        <input type="hidden" name="productId" value="#(product.id)">
                                        <button class="button button_small" type="submit">В корзину</button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    #endfor
                </div>
            #endif
        </section>
    </div>
</main>

<footer class="site-footer">
    <div class="container footer-grid">
        <div class="footer-col">
            <h2 class="footer-col__title">О нас</h2>
            <p>
                GameCard — небольшой магазин пополнения игровых аккаунтов.
                Мы продаём карты PlayStation Store и Apple Gift Card, пополняем Steam по логину,
                а также продаём игры для PS5. Работаем с 2026 года и выдаём коды в течение нескольких минут.
            </p>
            <p><a href="/about">Подробнее о магазине</a> · <a href="/about#contacts">Как нас найти</a></p>
        </div>
        <div class="footer-col">
            <h2 class="footer-col__title"><a href="/catalog">Каталог</a></h2>
            <p>Карты пополнения PlayStation Store и Apple Gift Card, пополнение Steam по логину и игры для PS5.</p>
        </div>
        <div class="footer-col">
            <h2 class="footer-col__title">Покупателям</h2>
            <ul>
                <li><a href="/cart">Корзина и заказ</a></li>
                <li><a href="/profile">Личный кабинет</a></li>
                <li><a href="/about#contacts">Контакты</a></li>
            </ul>
        </div>
        <div class="footer-col footer-contacts">
            <h2 class="footer-col__title">Контакты</h2>
            <address>
                241035, г. Брянск, ул. Бульвар 50-летия Октября, 7<br>
                БГТУ, Бежицкий район<br>
                Почта: <a href="mailto:shin_guards_0t@icloud.com">shin_guards_0t@icloud.com</a><br>
                Режим работы: ежедневно с 10:00 до 23:00
            </address>
            <button class="button button_ghost button_small" type="button" onclick="window.print()">Версия для печати</button>
        </div>
    </div>
    <div class="container footer-bottom">
        <p>© 2026 GameCard. Все права защищены.</p>
    </div>
</footer>

<nav class="tabbar">
    <ul class="tabbar__list">
        <li><a class="tab" href="/"><span class="tab__icon">🏠</span>Главная</a></li>
        <li><a class="tab tab_active" href="/catalog"><span class="tab__icon">🛍️</span>Каталог</a></li>
        <li><a class="tab" href="/cart"><span class="tab__icon">🛒</span>Корзина</a></li>
        <li><a class="tab" href="/profile"><span class="tab__icon">👤</span>Профиль</a></li>
        <li><a class="tab" href="/admin"><span class="tab__icon">⚙️</span>Админ панель</a></li>
    </ul>
</nav>

<!-- Всплывающее окно (п.5) -->
<div id="authModal" class="auth-modal" hidden>
    <div class="auth-modal__overlay" onclick="hideAuthModal()"></div>
    <div class="auth-modal__box">
        <button class="auth-modal__close" type="button" onclick="hideAuthModal()">×</button>
        <h2 class="auth-modal__title" id="authTitle">Вход</h2>
        <p class="auth-modal__message" id="authMessage" hidden></p>
        <div class="auth-modal__tabs">
            <button type="button" class="auth-modal__tab auth-modal__tab_active"
                    id="tabLogin" onclick="switchAuthTab('login')">Вход</button>
            <button type="button" class="auth-modal__tab"
                    id="tabRegister" onclick="switchAuthTab('register')">Регистрация</button>
        </div>
        <form class="auth-modal__form" id="authLoginForm" action="/login" method="post">
            <input class="form__input" name="login" placeholder="Логин" required>
            <input class="form__input" name="password" type="password" placeholder="Пароль" required>
            <button class="button" type="submit">Войти</button>
            <p style="margin-top:4px; font-size:13px; text-align:right;">
                <a href="/forgot">Забыли пароль?</a>
            </p>
        </form>
        <form class="auth-modal__form" id="authRegisterForm" action="/register"
              method="post" enctype="multipart/form-data" hidden>
            <input class="form__input" name="login" placeholder="Логин" required>
            <input class="form__input" name="password" type="password" placeholder="Пароль" required>
            <input class="form__input" name="fullName" placeholder="ФИО" required>
            <input class="form__input" name="email" type="email" placeholder="Email" required>

            <label style="color:#a3a5c9; font-size:14px;">Аватар (не обязательно):</label>
            <input class="form__input" name="avatar" type="file" accept="image/*">

            <button class="button" type="submit">Зарегистрироваться</button>
        </form>
    </div>
</div>

<script src="/auth.js"></script>
</body>
</html>
