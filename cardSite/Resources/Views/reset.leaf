<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Новый пароль — GameCard</title>
    <link rel="icon" href="/images/logo.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="/print.css" media="print">
</head>
<body>
    <div class="container section">
        <section class="profile-card">
            <h1 class="profile-card__title">Новый пароль</h1>

            #if(error != ""):
                <p class="form__message form__message_error">#(error)</p>
                <p><a class="button" href="/forgot">Запросить ссылку ещё раз</a></p>
            #else:
                <p class="profile-card__text">
                    Придумайте новый пароль — минимум 6 символов. После сохранения войдите с ним.
                </p>

                <form action="/reset" method="post" class="form" style="margin:0 auto; text-align:left;">
                    <input type="hidden" name="token" value="#(token)">
                    <input class="form__input" type="password" name="password"
                           placeholder="Новый пароль" required>
                    <button class="button" type="submit">Сохранить пароль</button>
                </form>
            #endif

            <p style="margin-top:22px;"><a href="/">На главную</a></p>
        </section>
    </div>
</body>
</html>
